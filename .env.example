# Django settings for local Docker Compose use
DEBUG=True
# Leave blank for the development-only fallback. Generate a strong key before
# setting DEBUG=False: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=
ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=http://localhost:8001,http://127.0.0.1:8001

# SQLite database persisted through the ./data Docker volume
DATABASE_URL=sqlite:///data/db.sqlite3
# For a separately managed PostgreSQL database, use a URL such as:
# DATABASE_URL=postgresql://user:password@your-db-host:5432/stock_management?sslmode=require

# Redis Settings
REDIS_URL=redis://redis:6379/0

# Email Settings
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=your-email@gmail.com
EMAIL_HOST_PASSWORD=your-app-password
DEFAULT_FROM_EMAIL=your-email@gmail.com

# File Storage (AWS S3)
AWS_ACCESS_KEY_ID=your-aws-access-key
AWS_SECRET_ACCESS_KEY=your-aws-secret-key
AWS_STORAGE_BUCKET_NAME=your-bucket-name
AWS_S3_REGION_NAME=us-east-1

# Leave mode-dependent settings blank to use safe defaults for DEBUG.
# With DEBUG=False, SSL redirect, secure cookies, one-year HSTS and the trusted
# X-Forwarded-Proto/X-Forwarded-For headers default on. Keep HSTS
# subdomains/preload off unless every subdomain is permanently HTTPS-enabled.
SECURE_BROWSER_XSS_FILTER=True
SECURE_CONTENT_TYPE_NOSNIFF=True
SECURE_HSTS_INCLUDE_SUBDOMAINS=
SECURE_HSTS_PRELOAD=
SECURE_HSTS_SECONDS=
SECURE_SSL_REDIRECT=
SESSION_COOKIE_SECURE=
CSRF_COOKIE_SECURE=
USE_X_FORWARDED_PROTO=
TRUST_X_FORWARDED_FOR=

# Analytics retention (used by `manage.py analytics_cleanup`).
# Behavioural data (page views/sessions/devices) is purged after 180 days;
# stored client IPs are redacted after 30 days.
ANALYTICS_RETENTION_DAYS=180
ANALYTICS_IP_RETENTION_DAYS=30

# Logging
LOG_LEVEL=INFO
DJANGO_LOG_LEVEL=INFO

# Development Settings
DJANGO_CREATE_SUPERUSER=false
DJANGO_LOAD_INITIAL_DATA=false

# Sentry (Error Monitoring)
SENTRY_DSN=your-sentry-dsn
SENTRY_ENVIRONMENT=production

# Analytics (Optional)
GOOGLE_ANALYTICS_ID=your-ga-id

# API Rate Limiting
RATELIMIT_ENABLE=True
RATELIMIT_RATE=100/hour

# Cache Settings
CACHE_TIMEOUT=3600
CACHE_MIDDLEWARE_SECONDS=600

# Session Settings
SESSION_COOKIE_AGE=86400  # 24 hours
SESSION_SAVE_EVERY_REQUEST=True

# File Upload Settings
FILE_UPLOAD_MAX_MEMORY_SIZE=5242880  # 5MB
DATA_UPLOAD_MAX_MEMORY_SIZE=5242880  # 5MB

# Pagination Settings
PAGINATE_BY=20
MAX_PAGINATE_BY=100

# Backup Settings
BACKUP_ENABLED=True
BACKUP_SCHEDULE=0 2 * * *  # Daily at 2 AM
BACKUP_RETENTION_DAYS=30

# Maintenance Mode
MAINTENANCE_MODE=False
MAINTENANCE_MESSAGE="System is under maintenance. Please try again later."

# Feature Flags
ENABLE_API=True
ENABLE_REPORTS=True
ENABLE_AUDIT_LOG=True
ENABLE_QR_CODES=True
ENABLE_PDF_EXPORT=True
ENABLE_EMAIL_NOTIFICATIONS=True
ENABLE_USER_REGISTRATION=True

# Performance Settings
ENABLE_CACHING=True
ENABLE_COMPRESSION=True
ENABLE_BROTLI_COMPRESSION=True
ENABLE_ETAGS=True
ENABLE_GZIP=True

# Password length and complexity are enforced by Django's validators in
# app_conf/settings.py. Change that policy in code and test it before rollout.
# Login throttling should be enforced by the production identity provider or proxy.

# Media Settings
MEDIA_ROOT=/app/mediafiles
MEDIA_URL=/media/
STATIC_ROOT=/app/staticfiles
STATIC_URL=/static/

# CORS Settings (for API)
CORS_ALLOWED_ORIGINS=http://localhost:3000,https://your-frontend-domain.com
CORS_ALLOW_CREDENTIALS=True

# Celery Settings (for background tasks)
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0
CELERY_ACCEPT_CONTENT=json
CELERY_TASK_SERIALIZER=json
CELERY_RESULT_SERIALIZER=json
CELERY_TIMEZONE=UTC

# Health Check
HEALTH_CHECK_ENABLED=True
HEALTH_CHECK_URL=/health/

# Monitoring
ENABLE_METRICS=True
METRICS_PORT=8001

# Social Authentication settings removed: project no longer uses django-allauth/social providers
# If you need to restore social auth, re-add provider keys here and re-enable allauth in settings

# Site Configuration
SITE_DOMAIN=localhost:8001
SITE_NAME=Stock Management System
